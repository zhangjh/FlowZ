{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "title": "FlowZ",
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build:renderer",
    "beforeDevCommand": "node ../scripts/tauri-stage-resources.mjs && npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/renderer",
    "beforeBundleCommand": "node ../scripts/tauri-stage-resources.mjs"
  },
  "bundle": {
    "active": true,
    "icon": [
      "../build/icon.ico",
      "../build/icon.icns",
      "../build/icon.png"
    ],
    "targets": "all",
    "resources": [
      "bundle-resources/*"
    ],
    "createUpdaterArtifacts": true
  },
  "identifier": "com.flowz.app",
  "productName": "FlowZ",
  "version": "3.7.5",
  "plugins": {
    "autostart": {
      "active": true
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/zhangjh/FlowZ/releases/latest/download/latest.json"
      ],
      "pubkey": "TODO: 运行 `tauri signer generate` 后填入公钥",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
